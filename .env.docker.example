# ── UNILIV Admin — Docker runtime env ────────────────────────────────────────
# Copy to .env.docker (gitignored) and fill in. Consumed by the `api` and
# `tools` containers (docker-compose.yml `env_file`).

# Runtime mode for ALL services — set it here once (no longer duplicated in
# docker-compose.yml). Logs are plain JSON regardless (see LOG_PRETTY below).
#
# SECURITY NOTE: production fails CLOSED — a strong SESSION_SECRET is required,
# the DEV_OTP master code and the `devOtp` echo in OTP responses are disabled
# (and DEV_OTP must be UNSET or the process refuses to boot), and the SES webhook
# requires SES_SNS_TOPIC_ARN. Wire Twilio (below) so real OTP SMS is delivered.
NODE_ENV=production

# Process timezone. The app's date logic (notably the Place-Order cut-off) anchors
# to IST in code regardless of this value, so this is defense-in-depth: it keeps
# the container's wall clock (logs, any host-local Date math) in Asia/Kolkata too.
# Must remain Asia/Kolkata on the deployed .env.docker.
TZ=Asia/Kolkata

# Force the Secure flag on session/refresh cookies regardless of NODE_ENV. Set
# to "true" on any HTTPS deployment. (Defaults: on for NODE_ENV=production, off
# otherwise — so an HTTPS+development box MUST set this to true explicitly.)
COOKIE_SECURE=true

# Browser origins allowed by CORS (comma-separated). Defaults to APP_BASE_URL
# when unset. Never leave this wide open with credentials. Example:
# CORS_ORIGINS=https://unilivues1.enaacreations.com
# CORS_ORIGINS=

# Postgres connection pool bounds (optional; sane defaults shown).
# PG_POOL_MAX=10
# PG_CONN_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000

# Run the in-process schedulers (SLA checks, billing cycles, reminders) in THIS
# instance. Set to "false" on all-but-one replica when scaling horizontally so
# jobs don't double-fire. Default: true.
# RUN_SCHEDULERS=true

# Max request body size (mitigates memory-exhaustion DoS). Default 1mb.
# BODY_LIMIT=1mb

# REQUIRED in production: the expected SNS Topic ARN for the SES bounce/complaint
# webhook. The webhook fails CLOSED in production when this is unset (rejects all
# events) and otherwise rejects events from any other topic (anti-forgery).
SES_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:uniliv-ses-events
# Pretty (human) logs are OPT-IN and need the dev bundle's worker, so leave this
# unset in Docker. It's set automatically for local `pnpm dev`.
# LOG_PRETTY=true

# PostgreSQL on the HOST (NOT containerised), reached over its Unix socket which
# the compose file bind-mounts at /var/run/postgresql. No TCP exposure — host
# Postgres can keep listen_addresses = 'localhost'. Needs a password role + a
# `local … scram-sha-256` pg_hba line (see DEPLOYMENT.md §1).
DATABASE_URL=postgresql://admin:CHANGE_ME@/uniliv?host=/var/run/postgresql

# ⚠ If the password has URL-special chars (/, #, @, :, space, %), either
# URL-encode them in DATABASE_URL (e.g. / → %2F, # → %23), OR — simpler — comment
# out DATABASE_URL above and use the raw PG* vars below instead (no encoding):
#PGHOST=/var/run/postgresql
#PGPORT=5432
#PGUSER=admin
#PGPASSWORD=your-raw-password-any-characters
#PGDATABASE=uniliv

# JWT signing secret for access + refresh tokens (REQUIRED).
# Generate one:  openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public browser-facing origin of the app (no trailing slash). Used to build the
# Google OAuth redirect URI AND the password-reset / forgot-username email links.
# REQUIRED for those emailed links to carry a host — without it the link is
# host-less (/reset-password/<token>) and won't open.
APP_BASE_URL=https://unilivues1.enaacreations.com

# ── Dev-only master OTP (MUST be unset in production) ─────────────────────────
# DEV_OTP is a fixed code that always passes OTP verification. It is honoured
# ONLY when NODE_ENV=development AND ALLOW_DEV_OTP=true. In production it is
# ignored — and the API REFUSES TO BOOT if DEV_OTP is set — so leave it unset.
# DEV_OTP=000000

# ── Field-level encryption key for KYC data (REQUIRED in production) ───────────
# Generate once:  openssl rand -hex 32
# ENCRYPTION_KEY=

# ── Transactional email over SMTP ─────────────────────────────────────────────
# nodemailer IS bundled into the slim api image, so setting SMTP_HOST is enough
# to send mail — nothing else has to be added to the image.
# ⚠ FAIL-CLOSED: in any NODE_ENV other than `development`, an EMAIL channel with
# no provider configured is NOT delivered and NOT logged. The notification stays
# PENDING in notification_outbox with the reason in last_error, and the api's
# outbox sweep re-attempts it (one attempt per minute after a 2-minute grace).
# That budget is FINITE — 6 attempts in total across all retry paths, after which
# the row is recorded FAILED and is never retried again. So a provider configured
# within a few minutes still gets the backlog out; anything older is lost. Rows
# are kept with their last_error either way. Configure SMTP or SES in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=UNILIV <no-reply@unilivues1.enaacreations.com>

# ── Optional: email via Amazon SES (preferred over SMTP for deliverability) ───
# Selected when EMAIL_PROVIDER=ses, and it takes PRIORITY over SMTP_HOST — so set
# it only when SES is actually usable. @aws-sdk/client-sesv2 IS bundled into the
# slim api image (build.mjs does not externalise it AND notify-core imports it by
# a literal specifier, both of which are required) — and so is sns-validator, the
# signature check the /api/webhooks/ses endpoint below rejects every event
# without. Verify on a built image with
# `API_BUNDLE_VERIFY=strict pnpm --filter @workspace/api-server run build`, which
# asserts both halves and names anything the image would have to resolve at
# runtime; a bare `grep -c` on the output cannot. The sending identity/domain
# must be verified in SES, and for bounce/complaint suppression point a
# configuration set's SNS topic at https://<host>/api/webhooks/ses.
# A hard bounce or complaint suppresses that
# address permanently — inspect and clear the list via
# GET/DELETE /api/notifications/suppressions (SUPER_ADMIN).
# EMAIL_PROVIDER=ses
# AWS_SES_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=UNILIV <no-reply@unilivues1.enaacreations.com>
# AWS_SES_CONFIGURATION_SET=
# Dev-only: skip SNS signature verification on the SES webhook (ignored in prod).
# SES_WEBHOOK_SKIP_VERIFY=0

# ── SMS via Twilio (OTP + every SMS notification) ─────────────────────────────
# ALL THREE of TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM are required
# before the SMS channel is selected at all — a partial config counts as no
# provider. With none of them set, OTP codes are only logged (fine for dev), and
# in any NODE_ENV other than `development` SMS notifications are not delivered:
# they stay PENDING in the outbox with the reason, exactly as EMAIL does above.
# Set these for any production deployment.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Optional: Google sign-in (button is hidden when unset) ────────────────────
# OAuth client (Web) from Google Cloud Console → Credentials. Authorised redirect
# URI must be exactly ${APP_BASE_URL}/api/auth/google/callback. Sign-in is for
# existing active users matched by verified email — it never creates accounts.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=   # optional override; defaults to APP_BASE_URL + /api/auth/google/callback
# GOOGLE_ALLOWED_HD=           # optional: lock to one Google Workspace domain, e.g. uniliv.com

# ── Optional: async notification worker (BullMQ on Redis) ─────────────────────
# When REDIS_URL is set, notify() enqueues and the notify-service worker delivers
# with retries/DLQ. Unset → the api delivers inline with bounded retry, which is
# a supported configuration, not a degraded one: a send that still fails stays
# PENDING (never terminally FAILED) and the api's own outbox sweep — wired into
# the RUN_SCHEDULERS block, every 60s — retries it.
# ⚠ Setting REDIS_URL WITHOUT running a notify-service container is the one
# combination to avoid, and it is worse than "delayed": nothing is delivered at
# all. The sweep hands a queued row back to the queue (that is the worker's job,
# and re-enqueuing must not also spend the row's attempt budget), so with Redis
# reachable and no consumer the row is re-enqueued every 60s forever — never
# delivered inline, and never even recorded FAILED. The inline fallback only
# engages when Redis itself is unreachable. There is no notify-service in
# docker-compose.yml yet, so leave REDIS_URL unset unless you add one.
# REDIS_URL=redis://localhost:6379
# NOTIFY_WORKER_CONCURRENCY=10
# NOTIFY_HEALTH_PORT=8091

# ── Optional: web push (VAPID) ────────────────────────────────────────────────
# Enables the bell's "desktop alerts" toggle + browser push. Generate once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# ⚠ Same slim-image caveat as SES: web-push is externalised, so it won't load in
# the bundled api image until docker/Dockerfile bundles it or ships node_modules.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@uniliv.com

# ── Optional: payments ────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
