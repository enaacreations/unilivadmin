# ─── Web app env template — copy to .env.web and fill in ─────────────────────
# Only these variables are read by the Vite dev server / build
# (artifacts/uniliv-admin/vite.config.ts). Load it with:
#   set -a; source .env.web; set +a
#
# Keep secrets OUT of this file — anything Vite inlines ends up in the browser
# bundle. Database URLs, session secrets and API keys belong in .env.api.

NODE_ENV=development

# Vite dev-server port and the base path the SPA is served under. Both are
# REQUIRED — vite.config.ts throws at startup if either is missing.
PORT=3000
BASE_PATH=/

# Dev-only reverse proxy: /api → the Express server, so the SPA stays
# same-origin and cookie auth works without CORS. Must point at PORT in
# .env.api. Leave unset in environments where an external router handles /api
# (e.g. Replit, the docker compose stack).
API_PROXY_TARGET=http://localhost:8090

# Browser-facing origin of the app. Mirrors APP_BASE_URL in .env.api.
# APP_BASE_URL=http://localhost:3000
